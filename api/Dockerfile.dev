FROM rust:1.100-slim

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends git pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy \
    && cargo install cargo-deny --locked \
    && cargo install watchexec-cli --locked --version 2.8.0

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} dev && useradd -m -u ${UID} -g ${GID} dev \
    && mkdir -p /work/target /usr/local/cargo/registry \
    && chown -R dev:dev /work /usr/local/cargo

USER dev
WORKDIR /work
